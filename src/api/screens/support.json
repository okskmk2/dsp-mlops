{
  "screens": [
    {
      "id": "guideList",
      "route": "/support/guides",
      "view": "src/views/SupportListView.vue",
      "purpose": "사용법 게시판.",
      "auth": true,
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "list",
          "method": "GET",
          "path": "/api/v1/support/posts",
          "query": { "board": "guide", "category": "string", "q": "string" },
          "response": { "items": ["SupportPostListItem"] }
        }
      ]
    },
    {
      "id": "guideDetail",
      "route": "/support/guides/:id",
      "view": "src/views/SupportPostView.vue",
      "purpose": "사용법 본문.",
      "auth": true,
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "get",
          "method": "GET",
          "path": "/api/v1/support/posts/:id",
          "response": { "post": "SupportPost" }
        }
      ]
    },
    {
      "id": "guideEdit",
      "route": "/support/guides/new|/support/guides/:id/edit",
      "view": "src/views/SupportEditView.vue",
      "purpose": "사용법 작성·수정.",
      "auth": true,
      "roles": ["dsp_admin"],
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "get",
          "method": "GET",
          "path": "/api/v1/support/posts/:id",
          "response": { "post": "SupportPost" }
        },
        {
          "id": "save",
          "method": "PUT",
          "path": "/api/v1/support/posts/:id?",
          "body": {
            "board": "guide",
            "title": "string",
            "category": "string",
            "body": "string",
            "pinned": "boolean",
            "status": "draft | published"
          },
          "roles": ["dsp_admin"]
        }
      ]
    },
    {
      "id": "noticeList",
      "route": "/support/notices",
      "view": "src/views/SupportListView.vue",
      "purpose": "공지 게시판.",
      "auth": true,
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "list",
          "method": "GET",
          "path": "/api/v1/support/posts",
          "query": { "board": "notice", "severity": "string", "q": "string" },
          "response": { "items": ["SupportPostListItem"] }
        }
      ]
    },
    {
      "id": "noticeDetail",
      "route": "/support/notices/:id",
      "view": "src/views/SupportPostView.vue",
      "purpose": "공지 본문.",
      "auth": true,
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "get",
          "method": "GET",
          "path": "/api/v1/support/posts/:id",
          "response": { "post": "SupportPost" }
        }
      ]
    },
    {
      "id": "noticeEdit",
      "route": "/support/notices/new|/support/notices/:id/edit",
      "view": "src/views/SupportEditView.vue",
      "purpose": "공지 작성·수정. important 게시 시 전 사용자 알림.",
      "auth": true,
      "roles": ["dsp_admin"],
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "get",
          "method": "GET",
          "path": "/api/v1/support/posts/:id",
          "response": { "post": "SupportPost" }
        },
        {
          "id": "save",
          "method": "PUT",
          "path": "/api/v1/support/posts/:id?",
          "body": {
            "board": "notice",
            "title": "string",
            "severity": "info | important",
            "body": "string",
            "pinned": "boolean",
            "expiresAt": "string | null",
            "status": "draft | published"
          },
          "roles": ["dsp_admin"]
        }
      ]
    }
  ]
}
