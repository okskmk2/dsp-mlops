{
  "screens": [
    {
      "id": "home",
      "route": "/home",
      "view": "src/views/HomeView.vue",
      "purpose": "이상 모델, 결재, 예산, 드리프트를 한눈에 본다. 로그인 후 최초 진입 화면.",
      "auth": true,
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "layout": {
        "sections": ["alertBanners", "kpiRow(4)", "attentionModels+pendingApprovals(2col)", "provisioning(fullWidth)"],
        "widgetFailureIsolation": "위젯별 개별 로딩/에러 상태. 한 위젯 실패가 다른 위젯 렌더를 막지 않음"
      },
      "endpoints": [
        {
          "id": "getHome",
          "method": "GET",
          "path": "/api/v1/home",
          "why": "KPI, 주의 모델, 내 결재 최대 3건, 진행 중 프로비저닝, 고정 공지",
          "roleScoping": "general은 소속 프로젝트로 서버 필터. officer/dsp_admin은 전 범위.",
          "response": {
            "kpis": {
              "championCount": "number",
              "monitorFailCount": "number",
              "driftCount": "number",
              "overBudgetProjectCount": "number"
            },
            "attentionModels": ["ModelListItem"],
            "attentionModelsSort": "severity(monitorFail > drift > championHealth 저하) desc, updatedAt desc",
            "pendingApprovals": ["ApprovalListItem"],
            "pendingApprovalsSort": "submittedAt asc",
            "pendingApprovalsLimit": 3,
            "provisioning": [
              {
                "projectId": "string",
                "projectName": "string",
                "projectStatus": "string",
                "rollup": "in_progress | failed"
              }
            ],
            "notices": ["SupportPostListItem"],
            "noticesLimit": 2
          }
        }
      ]
    }
  ]
}

