{
  "screens": [
    {
      "id": "notifications",
      "route": "/notifications",
      "view": "src/views/NotificationsView.vue",
      "purpose": "내 운영 이벤트. 스테이지 변경은 해당 프로젝트 멤버 전원.",
      "auth": true,
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "list",
          "method": "GET",
          "path": "/api/v1/notifications",
          "why": "내 알림 최신순",
          "response": { "items": ["Notification"] }
        },
        {
          "id": "markRead",
          "method": "POST",
          "path": "/api/v1/notifications/:id/read",
          "why": "한 건 읽음"
        },
        {
          "id": "markAllRead",
          "method": "POST",
          "path": "/api/v1/notifications/read-all",
          "why": "모두 읽음"
        }
      ]
    }
  ]
}
