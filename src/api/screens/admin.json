{
  "screens": [
    {
      "id": "adminUsers",
      "route": "/admin/users",
      "view": "src/views/admin/AdminUsersView.vue",
      "purpose": "플랫폼 사용자 등록·수정·비활성.",
      "auth": true,
      "roles": ["dsp_admin"],
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "list",
          "method": "GET",
          "path": "/api/v1/admin/users",
          "response": { "items": ["User"] }
        },
        {
          "id": "save",
          "method": "PUT",
          "path": "/api/v1/admin/users/:id?",
          "body": {
            "name": "string",
            "email": "string",
            "title": "string",
            "platformRole": "dsp_admin | officer | general",
            "isApprover": "boolean"
          }
        },
        {
          "id": "setEnabled",
          "method": "POST",
          "path": "/api/v1/admin/users/:id/enabled",
          "body": { "enabled": "boolean" }
        }
      ]
    },
    {
      "id": "adminPermissions",
      "route": "/admin/permissions",
      "view": "src/views/admin/AdminPermissionsView.vue",
      "purpose": "플랫폼 역할·승인권자·결재선·권한 매트릭스.",
      "auth": true,
      "roles": ["dsp_admin"],
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "matrix",
          "method": "GET",
          "path": "/api/v1/admin/permissions",
          "response": {
            "users": ["User"],
            "approvalLines": [
              { "type": "string", "approverId": "string" }
            ]
          }
        },
        {
          "id": "setPlatformRole",
          "method": "PATCH",
          "path": "/api/v1/admin/users/:id/platform-role",
          "body": { "platformRole": "string" }
        },
        {
          "id": "setApprover",
          "method": "PATCH",
          "path": "/api/v1/admin/users/:id/approver",
          "body": { "isApprover": "boolean" }
        },
        {
          "id": "saveLine",
          "method": "PUT",
          "path": "/api/v1/admin/approval-lines/:type",
          "body": { "approverId": "string" }
        }
      ]
    },
    {
      "id": "adminCodes",
      "route": "/admin/codes",
      "view": "src/views/admin/AdminCodeGroupsView.vue",
      "purpose": "공통 코드 그룹 목록.",
      "auth": true,
      "roles": ["dsp_admin"],
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "groups",
          "method": "GET",
          "path": "/api/v1/admin/code-groups",
          "response": {
            "items": [{ "group": "string", "label": "string", "count": "number" }]
          }
        }
      ]
    },
    {
      "id": "adminCodeGroup",
      "route": "/admin/codes/:group",
      "view": "src/views/admin/AdminCodesView.vue",
      "purpose": "한 코드 그룹의 코드 테이블.",
      "auth": true,
      "roles": ["dsp_admin"],
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "list",
          "method": "GET",
          "path": "/api/v1/admin/codes",
          "query": { "group": "string" },
          "response": { "items": ["Code"] }
        },
        {
          "id": "save",
          "method": "PUT",
          "path": "/api/v1/admin/codes/:id?",
          "body": {
            "group": "string",
            "code": "string",
            "label": "string",
            "sort": "number"
          }
        },
        {
          "id": "setEnabled",
          "method": "POST",
          "path": "/api/v1/admin/codes/:id/enabled",
          "body": { "enabled": "boolean" }
        }
      ]
    },
    {
      "id": "adminBatch",
      "route": "/admin/batch",
      "view": "src/views/admin/AdminBatchJobsView.vue",
      "purpose": "범용 배치 작업 스케줄·실행 상태 조회, 실패 건 재실행, 활성/비활성 토글.",
      "auth": true,
      "roles": ["dsp_admin"],
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "list",
          "method": "GET",
          "path": "/api/v1/admin/batch-jobs",
          "response": {
            "items": [
              {
                "id": "string",
                "name": "string",
                "description": "string",
                "schedule": "string(cron)",
                "enabled": "boolean",
                "lastRunAt": "string | null",
                "lastStatus": "queued | running | succeeded | failed",
                "lastDurationSec": "number | null",
                "lastError": "string | null"
              }
            ]
          }
        },
        {
          "id": "runs",
          "method": "GET",
          "path": "/api/v1/admin/batch-jobs/:id/runs",
          "why": "재실행 이력 모달",
          "response": {
            "items": [
              { "id": "string", "startedAt": "string", "finishedAt": "string | null", "status": "string", "message": "string | null" }
            ]
          }
        },
        {
          "id": "retry",
          "method": "POST",
          "path": "/api/v1/admin/batch-jobs/:id/retry",
          "why": "lastStatus=failed 인 건만 재실행 가능",
          "roles": ["dsp_admin"]
        },
        {
          "id": "setEnabled",
          "method": "POST",
          "path": "/api/v1/admin/batch-jobs/:id/enabled",
          "body": { "enabled": "boolean" },
          "roles": ["dsp_admin"]
        }
      ]
    },
    {
      "id": "adminUsage",
      "route": "/admin/usage",
      "view": "src/views/admin/AdminUsageStatsView.vue",
      "purpose": "사용자별 페이지뷰·API 호출 통계, 일별 추이, 상위 조회 페이지.",
      "auth": true,
      "roles": ["dsp_admin"],
      "usesCommon": ["session.me", "shell.badges", "shell.monitorSummary"],
      "endpoints": [
        {
          "id": "summary",
          "method": "GET",
          "path": "/api/v1/admin/usage/summary",
          "response": {
            "totalPageViews": "number",
            "totalApiCalls": "number",
            "activeUserCount": "number"
          }
        },
        {
          "id": "daily",
          "method": "GET",
          "path": "/api/v1/admin/usage/daily",
          "why": "일별 추이 라인차트",
          "response": {
            "items": [{ "date": "string", "pageViews": "number", "apiCalls": "number" }]
          }
        },
        {
          "id": "byApi",
          "method": "GET",
          "path": "/api/v1/admin/usage/apis",
          "why": "API별 호출 통계 테이블(사용자별 통계보다 우선)",
          "response": {
            "items": [
              { "method": "string", "path": "string", "calls": "number", "avgLatencyMs": "number", "errorRate": "number" }
            ]
          }
        },
        {
          "id": "byPage",
          "method": "GET",
          "path": "/api/v1/admin/usage/pages",
          "why": "상위 조회 페이지 바차트",
          "response": {
            "items": [{ "path": "string", "label": "string", "views": "number" }]
          }
        }
      ]
    }
  ]
}
