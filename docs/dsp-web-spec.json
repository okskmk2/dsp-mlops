  "workflows": [
    {
      "id": "createProject",
      "steps": [
        "owner fills form including AML and/or ADB checkboxes",
        "submit creates Approval project_create; Project.status=pending_approval",
        "approver approves or rejects",
        "on reject: Project.status=draft",
        "on approve: Project.status=active; notify requester",
        "side job only: create ProvisionRequest kind=workspace per checked platform with default compute class (does not change Project.status)",
        "UI 부가 타임라인이 ProvisionRequest.status를 갱신",
        "dsp_admin retryProvisioning: failed items re-queued; Project.status unchanged"
      ]
    },
    {
      "id": "publishSupportPost",
      "steps": [
        "dsp_admin writes SupportPost on board=guide or notice",
        "saveDraft keeps status=draft; only author and dsp_admin see it",
        "publish sets status=published, publishedAt if empty",
        "pinned published notices appear on home (max 2)",
        "notice severity=important 게시 시 전 사용자 notice_published 알림"
      ]
    },
    {
      "id": "analysisRequestIntake",
      "steps": [
        "any logged-in user submits AnalysisRequest; not an Approval",
        "notify all dsp_admin type=analysis_request_submitted",
        "dsp_admin triages: link to existing active project OR start project create OR reject",
        "link existing: status=linked_existing; linkedProjectId set; requester added as viewer if not already a member; notify requester and project owner",
        "new project: open /projects/new?fromRequest=:id with title→name, desiredOutcome→goal, problem+businessContext→background; Project.sourceRequestId set",
        "on project_create submit: request status=new_project, linkedProjectId=project.id",
        "reject: status=rejected with reason; notify requester",
        "dsp_admin may mark completed when linked work is done"
      ]
    },
    {
      "id": "closeProject",
      "steps": [
        "only from status=active",
        "owner submits Approval project_close; status stays active with pending-close banner",
        "approver approves or rejects",
        "on reject: remain active, banner cleared",
        "on approve: project.status=closed; writes disabled; pending compute_upgrade approvals cancelled; no reopen in v1"
      ]
    },
    {
      "id": "promoteChampion",
      "steps": [
        "challenger compared to current champion",
        "owner or coordinator submits Approval champion_promote",
        "approver decides by checklist (metrics, monitor pass, drift)",
        "on approve: previous champion demoted to challenger or archived; new champion set",
        "each stage change notifies all ProjectMember of that project (type=model_stage_change), including the displaced previous champion"
      ]
    },
    {
      "id": "driftDisqualify",
      "steps": [
        "backend periodic drift + threshold checks",
        "if breach: championHealth=at_risk, notify, GNB badge",
        "owner/coordinator may submit demote or retrain",
        "approver can confirm disqualify"
      ]
    },
    {
      "id": "retrain",
      "steps": [
        "user opens modal with reason + existing job id",
        "DSP triggers cloud job",
        "new version lands as draft or challenger per policy",
        "does not auto-replace champion"
      ]
    },
    {
      "id": "registerChallenger",
      "steps": [
        "draft model; owner|coordinator|member submits registerChallenger (no e-approval)",
        "stage becomes challenger",
        "notify all ProjectMember type=model_stage_change"
      ]
    },
    {
      "id": "upgradeCompute",
      "steps": [
        "precondition: Project.status==active, target platform kind=workspace succeeded, no in-flight compute_upgrade for that platform",
        "owner|coordinator|member opens /projects/:id/resources/:provisionId/upgrade, picks a higher catalog class + reason",
        "submit creates Approval type=compute_upgrade; amount=monthlyCost delta; notify payer (approver); notify owner if requester!=owner",
        "Project.status stays active; resource card shows 상향 결재 대기",
        "approver approves or rejects (reject reason required)",
        "on reject: spec unchanged; notify requester",
        "on approve: if delta > remaining budget, raise Project.budgetAmount to actual+delta in the same 품의; create ProvisionRequest kind=compute_upgrade queued; apply toSpec.computeClass on the workspace item when succeeded; notify requester provision_done",
        "dsp_admin retryProvisioning for failed upgrade items only; Project.status unchanged"
      ]
    }
  ],
  "integrations": {
    "azureMl": ["workspace provision", "compute class apply", "model registry read", "endpoint metrics read", "job trigger by id", "cost usage"],
    "azureDatabricks": ["workspace provision", "compute class apply", "mlflow registry read", "job run trigger by id", "system tables cost", "unity catalog lineage read"],
    "eApproval": ["submit", "callback approved/rejected"],
    "notify": ["inapp", "optional email"]
  },
  "uiPatterns": {
    "statusChips": {
      "projectStatus": {
        "draft": "neutral",
        "pending_approval": "warning",
        "active": "success",
        "closed": "neutral"
      },
