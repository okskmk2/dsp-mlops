  "workflows": [
    {
      "id": "createProject",
      "steps": [
        "owner fills form including AML and/or ADB checkboxes",
        "submit creates Approval project_create; Project.status=pending_approval",
        "approver approves or rejects",
        "on reject: Project.status=draft",
        "on approve: Project.status=active; notify requester",
        "side job only: create ProvisionRequest per checked platform (does not change Project.status)",
        "UI 부가 타임라인이 ProvisionRequest.status를 갱신",
        "dsp_admin retryProvisioning: failed items re-queued; Project.status unchanged"
      ]
    },
    {
      "id": "closeProject",
      "steps": [
        "only from status=active",
        "owner submits Approval project_close; status stays active with pending-close banner",
        "approver approves or rejects",
        "on reject: remain active, banner cleared",
        "on approve: project.status=closed; writes disabled; no reopen in v1"
      ]
    },
    {
      "id": "promoteChampion",
      "steps": [
        "challenger compared to current champion",
        "owner or coordinator submits Approval champion_promote",
        "approver decides by checklist (metrics, monitor pass, drift)",
        "on approve: previous champion demoted to challenger or archived; new champion set"
      ]
    },
    {
      "id": "driftDisqualify",
      "steps": [
        "backend periodic drift + threshold checks",
        "if breach: championHealth=at_risk, notify, GNB badge",
        "owner/coordinator may submit demote or retrain",
        "approver can confirm disqualify"
      ]
    },
    {
      "id": "retrain",
      "steps": [
        "user opens modal with reason + existing job id",
        "DSP triggers cloud job",
        "new version lands as draft or challenger per policy",
        "does not auto-replace champion"
      ]
    }
  ],
  "integrations": {
    "azureMl": ["workspace provision", "model registry read", "endpoint metrics read", "job trigger by id", "cost usage"],
    "azureDatabricks": ["workspace provision", "mlflow registry read", "job run trigger by id", "system tables cost", "unity catalog lineage read"],
    "eApproval": ["submit", "callback approved/rejected"],
    "notify": ["inapp", "optional email"]
  },
  "uiPatterns": {
    "statusChips": {
      "projectStatus": {
        "draft": "neutral",
        "pending_approval": "warning",
        "active": "success",
        "closed": "neutral"
      },
      "provisionItemStatus": {
        "queued": "neutral",
        "running": "info",
        "succeeded": "success",
        "failed": "danger"
      },
      "modelStage": {
        "draft": "neutral",
        "challenger": "info",
        "champion": "success"
      },
      "monitorResult": {
        "pass": "success",
        "fail": "danger",
        "no_data": "warning"
      }
    },
    "emptyStates": true,
    "deepLinkButtonLabel": "워크스페이스에서 열기"
  },
  "aiImplementationPrompt": {
    "instruction": "이 JSON을 기능·권한·라우팅의 단일 소스로, docs/design-system.json을 시각 언어의 단일 소스로 사용하여 DSP 웹앱을 구현하라. pages[].route와 layout.snb를 라우팅의 근거로 삼고, permissionMatrix 밖의 쓰기를 만들지 마라. 클라우드 학습 UI를 발명하지 말고 딥링크와 job-id 트리거만 구현하라. 카피는 한국어. UI는 디자인 시스템의 토큰·금지를 따른다(그림자·그라디언트 없음, 본문 16px, 라벨 14px, 메타 12px, 정수 px, 1920 기준, 모바일 분기 없음).",
    "mustImplementFirst": [
      "auth + platform/project roles",
      "project create + approval (Project.status) and separate provision items",
      "model registry stages",
      "monitor pass/fail + thresholds",
      "cost by project",
      "retrain request modal"
    ],
    "later": ["lineage graph", "contamination events", "drift charts"]
  }
}
