    "emptyStates": true,
    "deepLinkButtonLabel": "워크스페이스에서 열기"
  },
  "aiImplementationPrompt": {
    "instruction": "이 JSON을 기능·권한·라우팅의 단일 소스로, docs/design-system.json을 시각 언어의 단일 소스로 사용하여 DSP 웹앱을 구현하라. pages[].route와 layout.snb를 라우팅의 근거로 삼고, permissionMatrix 밖의 쓰기를 만들지 마라. 클라우드 학습 UI를 발명하지 말고 딥링크와 job-id 트리거만 구현하라. 카피는 한국어. UI는 디자인 시스템의 토큰·금지를 따른다(그림자·그라디언트 없음, 본문 문단 16px, UI 라벨·표 14px, 메타 12px, 정수 px, regular 밀도, 1920 설계 원점, 문서 min-width 1920 금지, 모바일 분기 없음).",
    "mustImplementFirst": [
      "auth + platform/project roles",
      "project create + approval (Project.status) and separate provision items",
      "compute upgrade request (member) + payer approval + catalog class apply",
      "model registry stages",
      "monitor pass/fail + thresholds",
      "cost by project",
      "retrain request modal"
    ],
    "later": ["lineage graph", "contamination events", "drift charts"]
  }
}
