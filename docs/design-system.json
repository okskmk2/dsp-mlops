{
  "meta": {
    "name": "DSP Design System",
    "product": "DS Platform",
    "version": "1.0.0",
    "locale": "ko-KR",
    "sourceOfTruth": true,
    "companionSpec": "./dsp-web-spec.json",
    "description": "내부 MLOps 관제 웹의 시각 언어. Apple HIG에 가까운 흑·백 정돈 UI, 어두운 빨강 primary, 라이트/다크, 1920 설계 원점·회의실 TV 확대. 모바일·태블릿 전용 레이아웃 없음."
  },
  "principles": [
    {
      "id": "monochrome-canvas",
      "rule": "화면의 기본 면은 검정·하양·중립 회색만 쓴다. 색은 행동·상태·포커스에만 쓴다."
    },
    {
      "id": "apple-like-order",
      "rule": "여백·정렬·1px 보더·절제된 코너로 계층을 만든다. 장식, 텍스처, 글래스, 네온을 쓰지 않는다."
    },
    {
      "id": "no-shadow-no-gradient",
      "rule": "box-shadow, text-shadow, drop-shadow, linear/radial/conic-gradient, mesh, glow는 금지."
    },
    {
      "id": "cpu-first-motion",
      "rule": "GPU가 빈약한 단말을 전제로 한다. 애니메이션은 색·투명도만, 짧게, 거의 쓰지 않는다."
    },
    {
      "id": "readable-for-older-adults",
      "rule": "본문 문단 16px, UI 라벨·표·컨트롤 14px, 메타 최소 12px, 기본 클릭 40px. 폰트 크기는 정수 px만. 가는 글씨·저대비 회색 본문을 쓰지 않는다."
    },
    {
      "id": "hierarchy-before-chrome",
      "rule": "크기·두께·색·여백 순으로 읽기 순서를 강제한다. 한 화면에 primary 행동은 하나."
    },
    {
      "id": "desktop-and-tv-only",
      "rule": "1920을 설계 원점으로 하고 2560·3840에서만 타이포를 확대한다. 모바일·태블릿용 스택·햄버거 레이아웃을 만들지 않는다. 문서에 min-width: 1920을 걸지 않는다."
    }
  ],
  "constraints": {
    "colorModel": "solid-hex-preferred",
    "boxShadow": "none",
    "textShadow": "none",
    "filter": "none",
    "backdropFilter": "none",
    "gradient": "none",
    "borderImage": "none",
    "mixBlendMode": "normal",
    "fontFamily": "system sans-serif only",
    "minFontPx": 12,
    "bodyFontPx": 16,
    "minHitTargetPx": 32,
    "preferredHitTargetPx": 40,
    "supportedSchemes": ["light", "dark"],
    "unsupportedViewports": ["mobile", "tablet", "touch-phone"],
    "gpuBudget": "low",
    "willChange": "forbidden",
    "transform3d": "forbidden",
    "parallax": "forbidden",
    "skeletonShimmer": "forbidden"
  },
  "viewport": {
    "base": {
      "id": "desktop-fhd",
      "width": 1920,
      "height": 1080,
      "rootFontPx": 16,
      "contentMaxWidth": 1920,
      "pagePaddingX": 24,
      "pagePaddingY": 20,
      "columnGap": 20,
      "note": "설계·컴포넌트·그리드의 원점. px 토큰은 이 해상도 기준. CSS min-width가 아니다."
    },
    "largeMonitor": {
      "id": "qhd",
      "minWidth": 2560,
      "rootFontPx": 16,
      "pagePaddingX": 24,
      "pagePaddingY": 20,
      "columnGap": 20
    },
    "meetingTv": {
      "id": "uhd-tv",
      "minWidth": 3840,
      "rootFontPx": 16,
      "pagePaddingX": 32,
      "pagePaddingY": 24,
      "columnGap": 24,
      "note": "회의실 대형 화면. 3m 가독성. 레이아웃 구조는 유지하고 타이포 토큰만 정수 px로 한 단계 키운다."
    },
    "breakpoints": [
      { "id": "base", "minWidth": 0, "rootFontPx": 16, "note": "기본 토큰. 뷰포트가 1920보다 작아도 이 토큰을 쓴다." },
      { "id": "largeMonitor", "minWidth": 2560, "rootFontPx": 16 },
      { "id": "meetingTv", "minWidth": 3840, "rootFontPx": 16 }
    ],
    "mediaQueryPolicy": {
      "allowed": ["min-width: 2560px", "min-width: 3840px", "prefers-color-scheme", "prefers-reduced-motion"],
      "forbidden": ["max-width 미디어쿼리로 모바일·태블릿 레이아웃 분기", "hover-only 필수 기능", "orientation 분기"]
    },
    "belowBase": {
      "policy": "same-layout-fluid",
      "behavior": "html/body/셸에 min-width: 1920을 걸지 않는다. 같은 GNB+SNB+main을 뷰포트 너비에 맞춘다. 표 등 넓은 블록만 내부 가로 스크롤. 스택·햄버거·바텀시트로 접지 않는다."
    },
    "viewportMeta": "width=device-width, initial-scale=1. width=1920으로 레이아웃 뷰포트를 고정하지 않는다."
  },
  "color": {
