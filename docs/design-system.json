    },
    "semanticMap": {
      "pageBackground": "canvas",
      "shellBackground": "canvasSubtle",
      "cardBackground": "surface",
      "modalBackground": "surfaceRaised",
      "tableHeaderBackground": "surfaceSunken",
      "gnbBackground": "#212121",
      "snbBackground": "canvasSubtle",
      "snbActiveBackground": "primarySubtle",
      "snbActiveForeground": "primary",
      "inputBackground": "surface",
      "inputBorder": "border",
      "inputBorderFocus": "primary",
      "divider": "borderSubtle",
      "kpiValue": "textPrimary",
      "kpiAlertValue": "danger"
    },
    "statusChips": {
      "note": "dsp-web-spec.json uiPatterns.statusChips 톤과 맞춘다. 면은 subtle, 글자·보더는 해당 시맨틱 색.",
      "neutral": { "bg": "neutralSubtle", "fg": "textPrimary", "border": "border" },
      "info": { "bg": "infoSubtle", "fg": "textPrimary", "border": "border" },
      "success": { "bg": "successSubtle", "fg": "success", "border": "success" },
      "warning": { "bg": "warningSubtle", "fg": "warning", "border": "warning" },
      "danger": { "bg": "dangerSubtle", "fg": "danger", "border": "danger" }
    },
    "rules": [
      "그라디언트 금지. 호버는 토큰으로 정의된 단색 치환만.",
      "투명 색은 overlay·disabled 외 금지. 보더·면에 rgba 그림자를 흉내 내지 않는다.",
      "primary는 CTA·포커스·현재 위치·링크에만. 차트 시리즈는 chart.series 7색만 쓰고 primary·textPrimary를 기본 시리즈로 쓰지 않는다.",
      "본문 텍스트는 textPrimary. textTertiary는 메타(시간, 단위, 힌트)만.",
      "라이트에서 본문 대비는 최소 7:1 목표(AAA 본문). textSecondary도 4.5:1 이상."
    ]
  },
  "typography": {
    "fontFamily": {
      "sans": "'Noto Sans KR', system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
      "icon": null,
      "rules": [
        "본문·UI는 Noto Sans KR. 코드·ID·메트릭 원값은 mono.",
        "Noto Sans KR 웨이트 400·600만 로드. 아이콘폰트·가변폰트 금지.",
        "font-synthesis: none. 가짜 볼드/이탤릭 금지."
      ]
    },
    "rendering": {
      "fontSmoothing": "antialiased",
      "textRendering": "optimizeLegibility",
      "hyphens": "none",
      "wordBreak": "keep-all",
      "lineBreak": "strict",
      "tabularNums": "KPI, 테이블 숫자, 비용, 퍼센트에 font-variant-numeric: tabular-nums"
    },
    "minimums": {
      "uiLabelPx": 14,
      "bodyPx": 16,
      "captionPx": 12,
