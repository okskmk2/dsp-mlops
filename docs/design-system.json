        "usage": "도움말, 타임스탬프, 보조 설명. 최소 크기."
      }
    },
    "viewportScale": {
      "note": "토큰별 정수 px. html root는 16px 고정. rem으로 비례 확대하지 않는다.",
      "largeMonitor": {
        "minWidth": 2560,
        "meta": 13,
        "label": 15,
        "body": 17,
        "titleSm": 20,
        "title": 24,
        "titleLg": 26,
        "display": 30
